---
import fs from "node:fs";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config";

const currentYear = new Date().getFullYear();

// 读取FooterConfig.html文件内容
let customFooterHtml = "";
try {
	const footerHtmlPath = path.join(
		process.cwd(),
		"src",
		"config",
		"FooterConfig.html",
	);
	customFooterHtml = fs.readFileSync(footerHtmlPath, "utf-8");
	// 移除HTML注释
	customFooterHtml = customFooterHtml.replace(/<!--[\s\S]*?-->/g, "").trim();
} catch (error) {
	console.warn(
		"FooterConfig.html 读取失败:",
		error instanceof Error ? error.message : String(error),
	);
}
---

<!-- 页脚：普通流位于文档末尾。site-footer 是 immersive-reading 的隐藏选择器，
     pointer-events-auto 用于覆盖首页 banner 下父级的 pointer-events: none，两者勿删 -->
<footer class="site-footer pointer-events-auto pb-4 md:pb-6">
	<div
		class="transition border-t border-black/10 dark:border-white/15 mt-10 mb-5 border-dashed mx-32"
	>
	</div>

	<div class="transition flex flex-col items-center justify-center px-6">
		<div class="transition text-50 text-sm text-center wrap">
			<div class="mb-2">
				{customFooterHtml && <div set:html={customFooterHtml} />}
			</div>
			<div
				class="mx-0.5 my-2.5 flex gap-x-2 gap-y-2.5 justify-center flex-wrap items-center"
			>
				&copy; <span id="copyright-year">{currentYear}</span>
				{profileConfig.name}. All Rights Reserved.
				<span aria-hidden="true">/</span>
				<span
					class="inline-flex items-center gap-1.5"
					title="北京时间（UTC+8，Asia/Shanghai）"
				>
					<Icon name="material-symbols:schedule" class="text-base opacity-70" />
					<span>北京时间</span>
					<span
						id="beijing-clock"
						class="font-medium tabular-nums text-neutral-700 dark:text-neutral-200"
						>--:--:--</span
					>
				</span>
			</div>
			<!--
				注意：请勿随意修改或删除 "Powered by Astro & Firefly" 部分，这是对开源项目的尊重和支持。
				需要增加底部内容时，直接编辑 src/config/FooterConfig.html 即可，不需要修改 Footer.astro。
				------
				Attention: Please do not modify or delete the "Powered by Astro & Firefly" section at will, 
				as this is a sign of respect and support for open-source projects.
				When you need to add the bottom content, 
				you can directly edit src/config/FooterConfig.html without modifying Footer.astro.
			-->
			<div class="mx-0.5 my-2.5 flex gap-x-2 gap-y-2.5 justify-center flex-wrap">
				<span>Powered by</span>
				<a
					class="transition link text-(--primary) font-medium"
					target="_blank"
					href="https://astro.build">Astro</a
				>
				<span aria-hidden="true">&</span>
				<a
					class="transition link text-(--primary) font-medium"
					target="_blank"
					href="https://github.com/CuteLeaf/Firefly">Firefly</a
				>
			</div>
		</div>
	</div>
</footer>

<script>
	// 北京时间（UTC+8）。优先向 time.syiban.com 对时，失败则退回本机时钟按 Asia/Shanghai 换算。
	const SYNC_URL = "https://time.syiban.com/get_bjtime_syhaomiao.php";
	const bjFormat = new Intl.DateTimeFormat("zh-CN", {
		timeZone: "Asia/Shanghai",
		hour: "2-digit",
		minute: "2-digit",
		second: "2-digit",
		hourCycle: "h23",
	});

	// 服务器时间 - 本机时间（毫秒）
	let clockOffset = 0;
	let clockStarted = false;

	// 接口返回 "Newtime" + base64("2026-07-26 10:11:07.238")
	function parseServerTime(text: string): number | null {
		let raw = text.trim();
		if (raw.startsWith("Newtime")) raw = raw.slice(7);
		const match = atob(raw).match(
			/(\d+)-(\d+)-(\d+)\s+(\d+):(\d+):(\d+)(?:\.(\d+))?/,
		);
		if (!match) return null;
		const ms = new Date(
			Number(match[1]),
			Number(match[2]) - 1,
			Number(match[3]),
			Number(match[4]),
			Number(match[5]),
			Number(match[6]),
			Number(match[7] ?? 0),
		).getTime();
		return Number.isNaN(ms) ? null : ms;
	}

	function updateClock(): void {
		const el = document.getElementById("beijing-clock");
		if (!el) return;
		el.textContent = bjFormat.format(new Date(Date.now() + clockOffset));
	}

	function syncClock(): void {
		fetch(`${SYNC_URL}?q=${Date.now()}`, { cache: "no-store" })
			.then((res) => (res.ok ? res.text() : Promise.reject(new Error("bad status"))))
			.then((text) => {
				const serverMs = parseServerTime(text);
				if (serverMs !== null) clockOffset = serverMs - Date.now();
			})
			.catch(() => {
				// 跨域或网络不可用时静默忽略，直接用本机时钟
			});
	}

	if (!clockStarted) {
		clockStarted = true;
		syncClock();
		// 每 30 分钟重新对时，每秒刷新显示
		window.setInterval(syncClock, 30 * 60 * 1000);
		window.setInterval(updateClock, 1000);
		document.addEventListener("astro:page-load", updateClock);
		document.addEventListener("swup:contentReplaced", updateClock);
	}
	updateClock();
</script>
